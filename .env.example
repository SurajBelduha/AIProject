# ========================================================
# AI Knowledge & Decision Assistant - Environment Configuration
# ========================================================

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Database Connection (SQLite default file path)
ConnectionStrings__DefaultConnection=Data Source=aiknowledge.db

# Optional External LLM Integration (OpenAI or Google Gemini)
# If left blank, the application automatically uses its high-fidelity
# built-in offline Semantic Engine & System 1 Decision Orchestrator
# without needing external paid keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
