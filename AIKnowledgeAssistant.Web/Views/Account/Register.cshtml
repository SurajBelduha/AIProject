@model AIKnowledgeAssistant.Application.DTOs.RegisterRequest
@{
    ViewData["Title"] = "Create Organization Account";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4 shadow-sm">
            <div class="text-center mb-4">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-3 mb-3">
                    <i class="bi bi-building-add fs-3"></i>
                </div>
                <h4 class="fw-bold mb-1">Register Organization</h4>
                <p class="text-muted small">Launch your AI Knowledge & Decision Assistant tenant</p>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="OrganizationName" class="form-label fw-semibold small">Organization / Company Name</label>
                    <input asp-for="OrganizationName" class="form-control" placeholder="e.g. Acme Health Corp" required />
                    <span asp-validation-for="OrganizationName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold small">Administrator Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="Jane Doe" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small">Admin Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="admin@acme.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold small">Password (min 6 characters)</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2">
                    <i class="bi bi-rocket-takeoff me-1"></i> Create Tenant & Generate Assistant
                </button>
            </form>

            <div class="text-center mt-4 pt-2 border-top">
                <span class="text-muted small">Already have an organization registered?</span>
                <a href="/Account/Login" class="text-decoration-none fw-semibold small ms-1">Sign In</a>
            </div>
        </div>
    </div>
</div>
