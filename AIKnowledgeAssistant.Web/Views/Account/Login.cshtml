@model AIKnowledgeAssistant.Application.DTOs.LoginRequest
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5 col-lg-4">
        <div class="card card-custom p-4 shadow-sm">
            <div class="text-center mb-4">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-3 mb-3">
                    <i class="bi bi-shield-lock-fill fs-3"></i>
                </div>
                <h4 class="fw-bold mb-1">Organization Login</h4>
                <p class="text-muted small">Access your isolated knowledge base & assistant controls</p>
            </div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small">Work Email</label>
                    <input asp-for="Email" id="loginEmail" class="form-control" placeholder="name@organization.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold small">Password</label>
                    <input asp-for="Password" id="loginPassword" type="password" class="form-control" placeholder="••••••••" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Dashboard
                </button>
            </form>

            <div class="position-relative my-4">
                <hr />
                <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 text-muted small">
                    Quick Evaluator Login
                </span>
            </div>

            <div class="d-grid gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="quickFill('admin@apex.edu', 'ApexAdmin2026!')">
                    <i class="bi bi-mortarboard me-1"></i> Tenant A: <strong>Apex University</strong>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="quickFill('admin@fintechglobal.com', 'FinTechAdmin2026!')">
                    <i class="bi bi-buildings me-1"></i> Tenant B: <strong>FinTech Global</strong>
                </button>
            </div>

            <div class="text-center mt-4 pt-2 border-top">
                <span class="text-muted small">Need an account for your organization?</span>
                <a href="/Account/Register" class="text-decoration-none fw-semibold small ms-1">Register now</a>
            </div>
        </div>
    </div>
</div>

<script>
    function quickFill(email, pass) {
        document.getElementById('loginEmail').value = email;
        document.getElementById('loginPassword').value = pass;
    }
</script>
