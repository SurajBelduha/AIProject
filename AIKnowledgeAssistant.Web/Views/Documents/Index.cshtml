@model List<AIKnowledgeAssistant.Application.DTOs.DocumentDto>
@{
    ViewData["Title"] = "Knowledge Base Management";
    var maxDocs = AIKnowledgeAssistant.Application.DTOs.DocumentUploadLimits.MaxDocumentsPerOrganization;
    var currentDocs = Model.Count;
    var percentage = Math.Min(100, (int)((double)currentDocs / maxDocs * 100));
    var canUpload = currentDocs < maxDocs;
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Knowledge Base Documents</h2>
        <p class="text-muted mb-0">Manage organization PDF documents, page extractions, and searchable chunks</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a href="/Dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- Upload Quota & Guidelines Alert -->
<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card card-custom p-4 h-100">
            <h5 class="fw-bold mb-2"><i class="bi bi-shield-check text-primary me-2"></i> Mandatory Quota Limits</h5>
            <div class="my-3">
                <div class="d-flex justify-content-between small fw-semibold mb-1">
                    <span>Document Limit</span>
                    <span>@currentDocs / @maxDocs Maximum</span>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar @(currentDocs >= maxDocs ? "bg-danger" : (currentDocs >= 8 ? "bg-warning" : "bg-primary"))" 
                         role="progressbar" style="width: @percentage%"></div>
                </div>
            </div>

            <ul class="list-unstyled small text-muted mb-0">
                <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i> Maximum <strong>10 PDF documents</strong> per organization</li>
                <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i> Maximum <strong>20 pages</strong> per PDF document</li>
                <li class="mb-0"><i class="bi bi-check2 text-success me-2"></i> Maximum <strong>10 MB</strong> file size per document</li>
            </ul>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card card-custom p-4 h-100">
            <h5 class="fw-bold mb-2"><i class="bi bi-cloud-arrow-up-fill text-primary me-2"></i> Upload New PDF Document</h5>
            
            @if (!canUpload)
            {
                <div class="alert alert-warning mb-0 mt-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Organization Limit Reached:</strong> You have reached the maximum quota of @maxDocs PDF documents. To upload a new or replacement document, please delete an existing document below.
                </div>
            }
            else
            {
                <form asp-action="Upload" method="post" enctype="multipart/form-data" class="mt-2" id="uploadForm">
                    @Html.AntiForgeryToken()
                    <div class="border border-2 border-dashed rounded-3 p-4 text-center bg-light mb-3" id="dropZone">
                        <i class="bi bi-file-earmark-pdf fs-1 text-primary opacity-75 mb-2 d-block"></i>
                        <span class="fw-semibold d-block mb-1">Select a PDF file to index</span>
                        <span class="text-muted small d-block mb-3">Up to 20 pages, maximum 10 MB (.pdf)</span>
                        <input type="file" name="file" id="pdfFileInput" class="form-control d-inline-block w-auto" accept="application/pdf" required />
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Text extraction and page indexing start immediately.</span>
                        <button type="submit" class="btn btn-primary-custom" id="btnUploadSubmit">
                            <i class="bi bi-upload me-1"></i> Upload & Process PDF
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

<!-- Uploaded Documents Table -->
<div class="card card-custom p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">
            <i class="bi bi-files text-primary me-2"></i> Indexed Knowledge Base Files (@Model.Count)
        </h5>
        <span class="badge bg-primary-subtle text-primary">Isolated Tenant Storage</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-folder2-open fs-1 opacity-50 mb-2 d-block"></i>
            <h6 class="fw-semibold">No documents uploaded yet</h6>
            <p class="small">Upload your first PDF above to enable questions and decision models for this organization.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 35%;">Document Name</th>
                        <th style="width: 15%;">Pages</th>
                        <th style="width: 15%;">Searchable Chunks</th>
                        <th style="width: 15%;">File Size</th>
                        <th style="width: 10%;">Uploaded</th>
                        <th style="width: 10%;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var doc in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-file-earmark-pdf-fill text-danger fs-4 me-2"></i>
                                    <div>
                                        <span class="fw-bold d-block">@doc.OriginalFileName</span>
                                        <span class="text-muted" style="font-size:0.75rem;">ID: @doc.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-book me-1"></i> @doc.PageCount pages
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info">
                                    <i class="bi bi-puzzle me-1"></i> @doc.ChunkCount chunks
                                </span>
                            </td>
                            <td>@doc.FormattedSize</td>
                            <td class="text-muted">@doc.UploadedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@doc.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete \'@doc.OriginalFileName\'? All its indexed chunks will be deleted immediately.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete document">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
<script>
    var input = document.getElementById('pdfFileInput');
    if (input) {
        input.addEventListener('change', function() {
            var file = this.files[0];
            if (file) {
                // Client-side quick check
                if (file.size > 10 * 1024 * 1024) {
                    alert('File exceeds 10 MB limit. Please select a smaller PDF.');
                    this.value = '';
                }
            }
        });
    }

    var form = document.getElementById('uploadForm');
    if (form) {
        form.addEventListener('submit', function() {
            var btn = document.getElementById('btnUploadSubmit');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Extracting & Indexing...';
            }
        });
    }
</script>
}
